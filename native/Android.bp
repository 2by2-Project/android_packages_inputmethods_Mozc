    cmd: "$(location mozc_rewriter_gen_usage_rewriter_dictionary_main) --usage_data_file=$(location third_party/japanese_usage_dictionary/usage_dict.txt) --cforms_file=$(location data/rules/cforms.def) --output_base_conjugation_suffix=$(genDir)/data_manager/oss/usage_base_conj_suffix.data --output_conjugation_suffix=$(genDir)/data_manager/oss/usage_conj_suffix.data --output_conjugation_index=$(genDir)/data_manager/oss/usage_conj_index.data --output_usage_item_array=$(genDir)/data_manager/oss/usage_item_array.data --output_string_array=$(genDir)/data_manager/oss/usage_string_array.data",
}

genrule {
    name: "mozc_data_manager_oss_mozc_dataset_for_oss_user_pos",
