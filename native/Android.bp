    cmd: "$(location mozc_rewriter_gen_symbol_rewriter_dictionary_main) --input=$(location data/symbol/symbol.tsv) --user_pos_manager_data=$(location :mozc_data_manager_oss_mozc_dataset_for_oss_user_pos_manager_data) --sorting_table=$(location data/rules/sorting_map.tsv) --ordering_rule=$(location data/symbol/ordering_rule.txt) --output_token_array=$(genDir)/data_manager/oss/symbol_token.data --output_string_array=$(genDir)/data_manager/oss/symbol_string.data",
}

genrule {
    name: "mozc_data_manager_oss_mozc_dataset_for_oss_usage",
    tools: ["mozc_rewriter_gen_usage_rewriter_dictionary_main"],
    srcs: [
        "data/rules/cforms.def",
