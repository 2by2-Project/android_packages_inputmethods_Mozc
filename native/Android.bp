genrule {
    name: "mozc_data_dictionary_oss_aux_dictionary",
    tools: ["mozc_dictionary_gen_aux_dictionary"],
    srcs: [
        "data/dictionary_oss/aux_dictionary.tsv",
        "data/dictionary_oss/id.def",
        "data/dictionary_oss/dictionary00.txt",
        "data/dictionary_oss/dictionary01.txt",
        "data/dictionary_oss/dictionary02.txt",
        "data/dictionary_oss/dictionary03.txt",
        "data/dictionary_oss/dictionary04.txt",
        "data/dictionary_oss/dictionary05.txt",
        "data/dictionary_oss/dictionary06.txt",
        "data/dictionary_oss/dictionary07.txt",
        "data/dictionary_oss/dictionary08.txt",
        "data/dictionary_oss/dictionary09.txt",
        ":mozc_dictionary_zip_code_data",
        "data/dictionary_manual/places.tsv",
        "data/dictionary_manual/words.tsv",
    ],
    out: ["data/dictionary_oss/aux_dictionary.txt"],
    cmd: "$(location mozc_dictionary_gen_aux_dictionary) --strict --output $(out) --aux_tsv $(location data/dictionary_oss/aux_dictionary.tsv) --id_def $(location data/dictionary_oss/id.def) --words_tsv $(location data/dictionary_manual/places.tsv) $(location data/dictionary_manual/words.tsv) --dictionary_txts $(location data/dictionary_oss/dictionary00.txt) $(location data/dictionary_oss/dictionary01.txt) $(location data/dictionary_oss/dictionary02.txt) $(location data/dictionary_oss/dictionary03.txt) $(location data/dictionary_oss/dictionary04.txt) $(location data/dictionary_oss/dictionary05.txt) $(location data/dictionary_oss/dictionary06.txt) $(location data/dictionary_oss/dictionary07.txt) $(location data/dictionary_oss/dictionary08.txt) $(location data/dictionary_oss/dictionary09.txt) $(location :mozc_dictionary_zip_code_data)",
}

genrule {
    name: "mozc_data_dictionary_oss_filtered_dictionary",
    tools: ["mozc_dictionary_gen_filtered_dictionary"],
    srcs: [
        "data/dictionary_oss/dictionary_filter.tsv",
        "data/dictionary_oss/dictionary00.txt",
        "data/dictionary_oss/dictionary01.txt",
        "data/dictionary_oss/dictionary02.txt",
        "data/dictionary_oss/dictionary03.txt",
        "data/dictionary_oss/dictionary04.txt",
        "data/dictionary_oss/dictionary05.txt",
        "data/dictionary_oss/dictionary06.txt",
        "data/dictionary_oss/dictionary07.txt",
        "data/dictionary_oss/dictionary08.txt",
        "data/dictionary_oss/dictionary09.txt",
        ":mozc_dictionary_zip_code_data",
    ],
    out: ["data/dictionary_oss/dictionary.txt"],
    cmd: "$(location mozc_dictionary_gen_filtered_dictionary) --output $(out) --filter_tsv $(location data/dictionary_oss/dictionary_filter.tsv) --dictionary_txts $(location data/dictionary_oss/dictionary00.txt) $(location data/dictionary_oss/dictionary01.txt) $(location data/dictionary_oss/dictionary02.txt) $(location data/dictionary_oss/dictionary03.txt) $(location data/dictionary_oss/dictionary04.txt) $(location data/dictionary_oss/dictionary05.txt) $(location data/dictionary_oss/dictionary06.txt) $(location data/dictionary_oss/dictionary07.txt) $(location data/dictionary_oss/dictionary08.txt) $(location data/dictionary_oss/dictionary09.txt) $(location :mozc_dictionary_zip_code_data)",
}

