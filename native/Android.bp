genrule {
    name: "mozc_base_config_file_stream_data",
    tools: ["mozc_base_gen_config_file_stream_data"],
    srcs: [
        "data/preedit/12keys-halfwidthascii.tsv",
        "data/preedit/12keys-hiragana.tsv",
        "data/preedit/12keys-hiragana_intuitive.tsv",
        "data/preedit/50keys-hiragana.tsv",
        "data/preedit/flick-halfwidthascii.tsv",
        "data/preedit/flick-halfwidthascii_ios.tsv",
        "data/preedit/flick-hiragana.tsv",
        "data/preedit/flick-hiragana_intuitive.tsv",
        "data/preedit/flick-number.tsv",
        "data/preedit/godan-hiragana.tsv",
        "data/preedit/hiragana-romanji.tsv",
        "data/preedit/kana.tsv",
        "data/preedit/notouch-hiragana.tsv",
        "data/preedit/qwerty_mobile-halfwidthascii.tsv",
        "data/preedit/qwerty_mobile-hiragana.tsv",
        "data/preedit/romanji-hiragana.tsv",
        "data/preedit/toggle_flick-halfwidthascii.tsv",
        "data/preedit/toggle_flick-halfwidthascii_ios.tsv",
        "data/preedit/toggle_flick-hiragana.tsv",
        "data/preedit/toggle_flick-hiragana_intuitive.tsv",
        "data/preedit/toggle_flick-number.tsv",
        "data/keymap/atok.tsv",
        "data/keymap/chromeos.tsv",
        "data/keymap/kotoeri.tsv",
        "data/keymap/mobile.tsv",
        "data/keymap/ms-ime.tsv",
        "data/keymap/overlay_henkan_muhenkan_to_ime_on_off.tsv",
    ],
    out: ["base/config_file_stream_data.inc"],
    cmd: "$(location mozc_base_gen_config_file_stream_data) --output $(genDir)/base/config_file_stream_data.inc -- $(location data/preedit/12keys-halfwidthascii.tsv) $(location data/preedit/12keys-hiragana.tsv) $(location data/preedit/12keys-hiragana_intuitive.tsv) $(location data/preedit/50keys-hiragana.tsv) $(location data/preedit/flick-halfwidthascii.tsv) $(location data/preedit/flick-halfwidthascii_ios.tsv) $(location data/preedit/flick-hiragana.tsv) $(location data/preedit/flick-hiragana_intuitive.tsv) $(location data/preedit/flick-number.tsv) $(location data/preedit/godan-hiragana.tsv) $(location data/preedit/hiragana-romanji.tsv) $(location data/preedit/kana.tsv) $(location data/preedit/notouch-hiragana.tsv) $(location data/preedit/qwerty_mobile-halfwidthascii.tsv) $(location data/preedit/qwerty_mobile-hiragana.tsv) $(location data/preedit/romanji-hiragana.tsv) $(location data/preedit/toggle_flick-halfwidthascii.tsv) $(location data/preedit/toggle_flick-halfwidthascii_ios.tsv) $(location data/preedit/toggle_flick-hiragana.tsv) $(location data/preedit/toggle_flick-hiragana_intuitive.tsv) $(location data/preedit/toggle_flick-number.tsv) $(location data/keymap/atok.tsv) $(location data/keymap/chromeos.tsv) $(location data/keymap/kotoeri.tsv) $(location data/keymap/mobile.tsv) $(location data/keymap/ms-ime.tsv) $(location data/keymap/overlay_henkan_muhenkan_to_ime_on_off.tsv)",
}

