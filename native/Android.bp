    out: [
        "data_manager/oss/user_pos_token_array.data",
        "data_manager/oss/user_pos_string_array.data",
        "data_manager/oss/pos_list.data",
    ],
    cmd: "$(location mozc_dictionary_gen_user_pos_data) --id_file=$(location data/dictionary_oss/id.def) --special_pos_file=$(location data/rules/special_pos.def) --user_pos_file=$(location data/rules/user_pos.def) --cforms_file=$(location data/rules/cforms.def) --output_token_array=$(genDir)/data_manager/oss/user_pos_token_array.data --output_string_array=$(genDir)/data_manager/oss/user_pos_string_array.data --output_pos_list=$(genDir)/data_manager/oss/pos_list.data",
}

genrule {
    name: "mozc_data_manager_oss_mozc_dataset_for_oss_user_pos_manager_data",
    tools: ["mozc_data_manager_dataset_writer_main"],
    srcs: [
        ":mozc_data_manager_oss_mozc_dataset_for_oss_user_pos",
        ":mozc_data_manager_oss_mozc_dataset_for_oss_pos_matcher",
        ":mozc_data_manager_oss_mozc_dataset_for_oss_pos_matcher{data_manager/oss/pos_matcher.data}",
        ":mozc_data_manager_oss_mozc_dataset_for_oss_user_pos{data_manager/oss/user_pos_token_array.data}",
